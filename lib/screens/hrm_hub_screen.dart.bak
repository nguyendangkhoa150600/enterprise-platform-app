  Widget _buildLegendDetailRow(String tag, Color tagColor, String desc, {Color? bgColor}) {
    return Row(
      children: [
        Container(
          width: 48,
          padding: const EdgeInsets.symmetric(vertical: 3),
          alignment: Alignment.center,
