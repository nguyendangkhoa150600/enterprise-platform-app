                            color: isCurrentMonth ? const Color(0xFF2563EB) : Colors.white,
                            borderRadius: BorderRadius.circular(6),
                            border: Border.all(color: isCurrentMonth ? const Color(0xFF2563EB) : const Color(0xFFCBD5E1)),
                          ),
                          child: Text(
                            sm['workdays']!,
