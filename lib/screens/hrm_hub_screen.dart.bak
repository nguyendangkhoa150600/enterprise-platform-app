  Widget _buildAttendanceDetailRow({
    required IconData icon,
    required String label,
    required String value,
  }) {
    return Row(
      children: [
        Icon(icon, size: 16, color: const Color(0xFF64748B)),
        const SizedBox(width: 8),
        Text(
          label,
          style: const TextStyle(fontSize: 12.5, color: Color(0xFF64748B)),
        ),
        const Spacer(),
        Text(
          value,
          style: const TextStyle(fontSize: 12.5, fontWeight: FontWeight.bold, color: Color(0xFF0F172A)),
        ),
      ],
    );
  }

  Widget _buildAttendanceDataTabContent() {
    final statusList = [
      {'key': 'ALL', 'label': 'Tất cả trạng thái'},
      {'key': 'VALID', 'label': 'Hợp lệ'},
      {'key': 'LATE', 'label': 'Đi muộn'},
      {'key': 'EARLY', 'label': 'Về sớm'},
      {'key': 'MISSING', 'label': 'Thiếu chấm'},
    ];

    final filteredRows = _attendanceDataRows.where((r) {
      if (_attendanceDataStatus != 'ALL' && r.status != _attendanceDataStatus) return false;
      if (_attendanceDataSearchQuery.isNotEmpty) {
        final q = _attendanceDataSearchQuery.toLowerCase();
        final name = r.employeeName.toLowerCase();
        final code = r.employeeCode.toLowerCase();
        final dept = (r.departmentName ?? '').toLowerCase();
        if (!name.contains(q) && !code.contains(q) && !dept.contains(q)) return false;
      }
      return true;
    }).toList();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // 1. Status Filter Pills with Refresh Action
        Row(
          children: [
            Expanded(
              child: SingleChildScrollView(
                scrollDirection: Axis.horizontal,
                child: Row(
                  children: statusList.map((st) {
                    final isSelected = _attendanceDataStatus == st['key'];
                    return Padding(
                      padding: const EdgeInsets.only(right: 6),
                      child: InkWell(
                        onTap: () {
                          setState(() => _attendanceDataStatus = st['key']!);
                          _loadAttendanceData();
                        },
                        borderRadius: BorderRadius.circular(20),
                        child: Container(
                          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                          decoration: BoxDecoration(
                            color: isSelected ? const Color(0xFF2563EB) : const Color(0xFFF1F5F9),
                            borderRadius: BorderRadius.circular(20),
                            border: Border.all(color: isSelected ? const Color(0xFF2563EB) : const Color(0xFFE2E8F0)),
                          ),
                          child: Text(
                            st['label']!,
                            style: TextStyle(
                              fontSize: 11.5,
                              fontWeight: isSelected ? FontWeight.bold : FontWeight.w500,
                              color: isSelected ? Colors.white : const Color(0xFF475569),
                            ),
                          ),
                        ),
                      ),
                    );
                  }).toList(),
                ),
              ),
            ),
            const SizedBox(width: 8),
            InkWell(
              onTap: () => _loadAttendanceData(),
              borderRadius: BorderRadius.circular(8),
              child: Container(
                height: 32,
                padding: const EdgeInsets.symmetric(horizontal: 10),
                decoration: BoxDecoration(
                  color: const Color(0xFFEFF6FF),
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(color: const Color(0xFFBFDBFE)),
                ),
                child: Row(
                  children: const [
                    Icon(Icons.refresh_rounded, size: 15, color: Color(0xFF2563EB)),
                    SizedBox(width: 4),
                    Text(
                      'Tải lại',
                      style: TextStyle(fontSize: 11.5, fontWeight: FontWeight.bold, color: Color(0xFF2563EB)),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
        const SizedBox(height: 12),

        // 2. Count Header
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text(
              '${filteredRows.length} lượt chấm công',
              style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: Color(0xFF475569)),
            ),
            Text(
              _timesheetMonthLabel,
              style: const TextStyle(fontSize: 11.5, color: Color(0xFF64748B)),
            ),
          ],
        ),
        const SizedBox(height: 8),

        // 3. Data List or Empty / Loading
        if (_isLoadingAttendanceData)
          const Padding(
            padding: EdgeInsets.symmetric(vertical: 40),
            child: Center(child: CircularProgressIndicator()),
          )
        else if (filteredRows.isEmpty)
          Center(
            child: Padding(
              padding: const EdgeInsets.symmetric(vertical: 40),
              child: Column(
                children: [
                  Icon(Icons.event_note_outlined, size: 44, color: Colors.grey.shade300),
                  const SizedBox(height: 10),
                  const Text('Chưa có dữ liệu chấm công cho bộ lọc này', style: TextStyle(fontSize: 13, color: Color(0xFF64748B))),
                  const SizedBox(height: 8),
                  TextButton.icon(
                    onPressed: () => _loadAttendanceData(),
                    icon: const Icon(Icons.sync, size: 16),
                    label: const Text('Đồng bộ từ hệ thống'),
                  ),
                ],
              ),
            ),
          )
        else
          ListView.separated(
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            itemCount: filteredRows.length,
            separatorBuilder: (_, __) => const SizedBox(height: 8),
            itemBuilder: (ctx, idx) {
              final row = filteredRows[idx];
              final isLate = row.lateMinutes > 0;
              final isEarly = row.earlyMinutes > 0;
              final statusColor = row.status == 'VALID'
                  ? const Color(0xFF16A34A)
                  : row.status == 'LATE'
                      ? const Color(0xFFD97706)
                      : row.status == 'EARLY'
                          ? const Color(0xFFEA580C)
                          : const Color(0xFFDC2626);

              final statusBg = row.status == 'VALID'
                  ? const Color(0xFFDCFCE7)
                  : row.status == 'LATE'
                      ? const Color(0xFFFEF3C7)
                      : row.status == 'EARLY'
                          ? const Color(0xFFFFEDD5)
                          : const Color(0xFFFEE2E2);

              final statusText = row.status == 'VALID'
                  ? 'Hợp lệ'
                  : row.status == 'LATE'
                      ? 'Đi muộn'
                      : row.status == 'EARLY'
                          ? 'Về sớm'
                          : 'Thiếu chấm';

              return Material(
                color: Colors.transparent,
                child: InkWell(
                  onTap: () => _showAttendanceDetailModal(row),
                  borderRadius: BorderRadius.circular(10),
                  child: Container(
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(10),
                      border: Border.all(color: const Color(0xFFE2E8F0)),
                      boxShadow: [
                        BoxShadow(
                          color: Colors.black.withValues(alpha: 0.02),
                          blurRadius: 4,
                          offset: const Offset(0, 1),
                        ),
                      ],
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Expanded(
                              child: Row(
                                children: [
                                  CircleAvatar(
                                    radius: 15,
                                    backgroundColor: const Color(0xFFEFF6FF),
                                    child: Text(
                                      row.employeeName.isNotEmpty ? row.employeeName[0].toUpperCase() : 'U',
                                      style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: Color(0xFF2563EB)),
                                    ),
                                  ),
                                  const SizedBox(width: 8),
                                  Expanded(
                                    child: Column(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        Text(
                                          row.employeeName,
                                          style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w700, color: Color(0xFF0F172A)),
                                          maxLines: 1,
                                          overflow: TextOverflow.ellipsis,
                                        ),
                                        Text(
                                          '${row.employeeCode} • ${row.departmentName ?? "Chưa phân bổ"}',
                                          style: const TextStyle(fontSize: 11, color: Color(0xFF64748B)),
                                          maxLines: 1,
                                          overflow: TextOverflow.ellipsis,
                                        ),
                                      ],
                                    ),
                                  ),
                                ],
                              ),
                            ),
                            Container(
                              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                              decoration: BoxDecoration(
                                color: statusBg,
                                borderRadius: BorderRadius.circular(6),
                              ),
                              child: Text(
                                statusText,
                                style: TextStyle(fontSize: 10.5, fontWeight: FontWeight.bold, color: statusColor),
                              ),
                            ),
                          ],
                        ),
                        const Padding(
                          padding: EdgeInsets.symmetric(vertical: 8),
                          child: Divider(height: 1, color: Color(0xFFF1F5F9)),
                        ),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Row(
                              children: [
                                const Icon(Icons.calendar_today_outlined, size: 12, color: Color(0xFF64748B)),
                                const SizedBox(width: 4),
                                Text(
                                  row.workDate,
                                  style: const TextStyle(fontSize: 11.5, fontWeight: FontWeight.w600, color: Color(0xFF334155)),
                                ),
                              ],
                            ),
                            Row(
                              children: const [
                                Text(
                                  'Xem chi tiết',
                                  style: TextStyle(fontSize: 11.5, fontWeight: FontWeight.w600, color: Color(0xFF2563EB)),
                                ),
                                SizedBox(width: 2),
                                Icon(Icons.chevron_right_rounded, size: 15, color: Color(0xFF2563EB)),
                              ],
                            ),
                          ],
                        ),
                        if (isLate || isEarly || (row.source != null && row.source!.isNotEmpty)) ...[
                          const SizedBox(height: 6),
                          Wrap(
                            spacing: 6,
                            runSpacing: 4,
                            children: [
                              if (isLate)
                                Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                                  decoration: BoxDecoration(color: const Color(0xFFFEF3C7), borderRadius: BorderRadius.circular(4)),
                                  child: Text('Trễ ${row.lateMinutes} phút', style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w600, color: Color(0xFFB45309))),
                                ),
                              if (isEarly)
                                Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                                  decoration: BoxDecoration(color: const Color(0xFFFFEDD5), borderRadius: BorderRadius.circular(4)),
                                  child: Text('Về sớm ${row.earlyMinutes} phút', style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w600, color: Color(0xFFC2410C))),
                                ),
                              if (row.source != null && row.source!.isNotEmpty)
                                Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                                  decoration: BoxDecoration(color: const Color(0xFFF1F5F9), borderRadius: BorderRadius.circular(4)),
                                  child: Text('Nguồn: ${row.source}', style: const TextStyle(fontSize: 10, color: Color(0xFF475569))),
                                ),
                            ],
                          ),
                        ],
                      ],
                    ),
                  ),
                ),
              );
            },
          ),
      ],
    );
  }

  // =========================================================================
  // MODALS CHO 7 MỤC CẤU HÌNH TRUNG TÂM HRM (1:1 VỚI BẢN WEB)
