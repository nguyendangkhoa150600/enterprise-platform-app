                  child: Text(
                    '${d['day']} ${d['date']}',
                    style: TextStyle(
                      fontSize: 10.5,
                      fontWeight: FontWeight.bold,
                      color: isToday ? Colors.white : const Color(0xFF475569),
                    ),
