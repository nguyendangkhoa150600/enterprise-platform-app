  String? _leavePolicyUpdatedAt;

  @override
  void dispose() {
    _configSearchCtrl.dispose();
    _configSubTabScrollCtrl.dispose();
    _calendarSearchCtrl.dispose();
    _gpsSearchCtrl.dispose();
    _payrollSearchCtrl.dispose();
    _leaveDaysPerYearCtrl.dispose();
    _leaveStartAfterMonthsCtrl.dispose();
    _seniorityCycleYearsCtrl.dispose();
    _seniorityExtraDaysCtrl.dispose();
    _leaveChangeNoteCtrl.dispose();
    super.dispose();
  }

  @override
  void initState() {
    super.initState();
    if (widget.initialView != null) {
      _activeView = widget.initialView!;
    } else if (widget.initialTabIndex == 1) {
      _activeView = 'requests';
    } else if (widget.initialTabIndex == 2) {
      _activeView = 'approvals';
    } else if (widget.initialTabIndex == 3) {
      if (widget.initialWorkforceSubTab == 1) {
        _activeView = 'shifts';
      } else if (widget.initialWorkforceSubTab == 2) {
        _activeView = 'payroll';
      } else {
        _activeView = 'employees';
      }
    } else {
      _activeView = 'dashboard';
    }

    _loadAllHrmData();
  }

  Future<void> _refreshGpsSites() async {
    try {
      final sites = await _hrmService.getGpsSites();
      if (mounted) {
        setState(() {
          _gpsSites = sites;
        });
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Đã cập nhật danh sách địa điểm GPS (${sites.length} địa điểm)'),
            duration: const Duration(seconds: 2),
            backgroundColor: const Color(0xFF0F766E),
          ),
        );
      }
    } catch (e) {
      debugPrint('[HrmHubScreen] _refreshGpsSites error: $e');
    }
  }

  Future<void> _loadAllHrmData() async {
    setState(() => _isLoading = true);
    try {
      final results = await Future.wait([
        _hrmService.getDashboardStats().catchError((e) => HrmDashboardStats.fromJson(const {})),
        _hrmService.getRequests().catchError((e) => <HrmRequestItem>[]),
        _hrmService.getEmployees(forceRefresh: true).catchError((e) => <HrmEmployeeItem>[]),
        _hrmService.getPayslips().catchError((e) => <HrmPayslipItem>[]),
        _hrmService.getShifts().catchError((e) => <HrmShift>[]),
        _attendanceService.getTodayAttendance().catchError((e) => null),
        _hrmService.getDependents().catchError((e) => <HrmDependentItem>[]),
        _hrmService.getSalaryAdvances().catchError((e) => <HrmSalaryAdvanceItem>[]),
        _attendanceService.getTimesheetBoard(month: _timesheetMonthKey, self: false, page: 1, pageSize: 100).catchError((e) => null),
        _hrmService.getPolicyConfig().catchError((e) => const HrmPolicyConfig()),
        _hrmService.getIntegrationDevices().catchError((e) => <HrmIntegrationDevice>[]),
        _hrmService.getPositions(forceRefresh: true).catchError((e) => <HrmPositionItem>[]),
        _hrmService.getAttendancePolicyVersions().catchError((e) => <Map<String, dynamic>>[]),
        _attendanceService.getAttendanceContext().catchError((e) => null),
        _hrmService.getWorkCalendarExceptions().catchError((e) => <Map<String, dynamic>>[]),
        _hrmService.getGpsSites().catchError((e) => <Map<String, dynamic>>[]),
        _hrmService.getPayrollPeriods().catchError((e) => <Map<String, dynamic>>[]),
        _hrmService.getAnnualLeavePolicy().catchError((e) => null),
      ]);

      if (mounted) {
        final board = results[8] as HrmTimesheetBoard?;
        final leavePolicy = results[17] as Map<String, dynamic>?;
        setState(() {
          _stats = results[0] as HrmDashboardStats;
          _requests = results[1] as List<HrmRequestItem>;
          _employees = results[2] as List<HrmEmployeeItem>;
          _payslips = results[3] as List<HrmPayslipItem>;
          _shifts = results[4] as List<HrmShift>;
          _todayAttendance = results[5] as AttendanceRecord?;
          _dependents = results[6] as List<HrmDependentItem>;
          _advances = results[7] as List<HrmSalaryAdvanceItem>;
          _enterpriseTimesheetBoard = board;
          if (board != null && board.month.state.isNotEmpty) {
            _timesheetPeriodState = board.month.state;
          }
          _policyConfig = results[9] as HrmPolicyConfig;
          _devices = results[10] as List<HrmIntegrationDevice>;
          _positions = results[11] as List<HrmPositionItem>;
          _policyVersions = results[12] as List<Map<String, dynamic>>;
          _attendanceContext = results[13] as AttendanceContext?;
          _calendarExceptions = results[14] as List<Map<String, dynamic>>;
          _gpsSites = results[15] as List<Map<String, dynamic>>;
          _payrollPeriods = results[16] as List<Map<String, dynamic>>;
          if (leavePolicy != null) {
            _applyServerLeavePolicy(leavePolicy);
          }
          _isLoading = false;
        });
      }
    } catch (e) {
      debugPrint('[HrmHubScreen] _loadAllHrmData unexpected error: $e');
      if (mounted) setState(() => _isLoading = false);
    }
  }

  Future<void> _refreshLeavePolicy() async {
    try {
      final policy = await _hrmService.getAnnualLeavePolicy();
      if (policy != null && mounted) {
        setState(() {
          _applyServerLeavePolicy(policy);
        });
      }
    } catch (e) {
      debugPrint('[HrmHubScreen] _refreshLeavePolicy error: $e');
    }
  }

  void _applyServerLeavePolicy(Map<String, dynamic> data) {
    debugPrint('[HrmHubScreen] _applyServerLeavePolicy with data: $data');
    final rawBasis = data['accrualBasis'] ?? data['basis'] ?? data['accrual_basis'] ?? data['start_date_type'];
    if (rawBasis != null) {
      final bStr = rawBasis.toString().toUpperCase();
      if (bStr.contains('CONTRACT') || bStr.contains('SIGN') || bStr.contains('HĐLĐ') || bStr.contains('HDLD')) {
        _leaveBasis = 'Ngày ký HĐLĐ';
      } else if (bStr.contains('CHÍNH THỨC') || bStr.contains('OFFICIAL')) {
        _leaveBasis = 'Ngày vào làm chính thức';
      } else if (bStr.contains('THỬ VIỆC') || bStr.contains('PROBATION') || bStr.contains('START') || bStr.contains('HIRE')) {
        _leaveBasis = 'Ngày bắt đầu thử việc';
      } else if (bStr.contains('01/01') || bStr.contains('YEAR') || bStr.contains('ANNUAL') || bStr.contains('CALENDAR')) {
        _leaveBasis = 'Ngày 01/01 hàng năm';33
      }
    }

    final days = data['annualDays'] ?? data['days_per_year'] ?? data['daysPerYear'] ?? data['annual_days'];
    if (days != null) {
      final numVal = num.tryParse(days.toString());
      if (numVal != null) {
        _leaveDaysPerYearCtrl.text = numVal % 1 == 0 ? numVal.toInt().toString() : numVal.toString();
      } else {
        _leaveDaysPerYearCtrl.text = days.toString();
      }
    }

    final months = data['startOffsetMonths'] ?? data['start_after_months'] ?? data['startAfterMonths'];
    if (months != null) {
      _leaveStartAfterMonthsCtrl.text = months.toString();
    }

    final advance = data['advanceAllowed'] ?? data['allow_advance'] ?? data['allowAdvance'];
    if (advance != null) {
      _leaveAllowAdvance = advance == true || advance == 1 || advance.toString().toLowerCase() == 'true';
    }

    if (data['seniorityTiers'] is List && (data['seniorityTiers'] as List).isNotEmpty) {
      final firstTier = (data['seniorityTiers'] as List).first;
      if (firstTier is Map) {
        final sYears = firstTier['minYears'] ?? firstTier['min_years'];
        if (sYears != null) _seniorityCycleYearsCtrl.text = sYears.toString();
        final sDays = firstTier['bonusDays'] ?? firstTier['bonus_days'];
        if (sDays != null) {
          final numVal = num.tryParse(sDays.toString());
          if (numVal != null) {
            _seniorityExtraDaysCtrl.text = numVal % 1 == 0 ? numVal.toInt().toString() : numVal.toString();
          } else {
            _seniorityExtraDaysCtrl.text = sDays.toString();
          }
        }
      }
    } else {
      final sYears = data['seniority_cycle_years'] ?? data['seniorityCycleYears'];
      if (sYears != null) _seniorityCycleYearsCtrl.text = sYears.toString();
      final sDays = data['seniority_extra_days'] ?? data['seniorityExtraDays'];
      if (sDays != null) {
        final numVal = num.tryParse(sDays.toString());
        if (numVal != null) {
          _seniorityExtraDaysCtrl.text = numVal % 1 == 0 ? numVal.toInt().toString() : numVal.toString();
        } else {
          _seniorityExtraDaysCtrl.text = sDays.toString();
        }
      }
    }

    _leavePolicyUpdatedAt = data['updatedAt']?.toString() ?? data['updated_at']?.toString();

    final y = data['effective_year'] ?? data['effectiveYear'] ?? data['apply_year'] ?? data['applyYear'] ?? data['year'];
    if (y != null && y.toString().isNotEmpty) {
      _leaveApplyYear = y.toString();
    }

    final note = data['change_note'] ?? data['changeNote'] ?? data['note'] ?? data['reason'];
    if (note != null && note.toString().isNotEmpty) {
      _leaveChangeNoteCtrl.text = note.toString();
    }
  }

  void _navigateToView(String viewKey) {
    setState(() {
      _activeView = viewKey;
    });
  }

